DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Independent signing/hash secret for inquiry anti-spam. Generate with openssl rand -base64 32.
LEAD_FORM_SECRET=
# Enable only behind a trusted proxy that overwrites x-forwarded-for.
INQUIRY_TRUST_PROXY=false

# Exact browser origin used for inquiries (scheme + hostname + port).
INQUIRY_ORIGIN=http://localhost:3000

# Live mode is intentionally unsupported. Configure only genuine sandbox credentials.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional separate read-only, repository-selected GitHub App installation token
# or fine-grained token. Never reuse OAuth sign-in secrets as repository tokens.
GITHUB_PROJECT_TOKEN=
GITHUB_PROJECT_WEBHOOK_SECRET=

# Private career resume/company-document retention; admin-triggered erasure, no automatic deletion.
CAREER_RETENTION_DAYS=365

# Account verification and recovery. For isolated development use loopback Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
