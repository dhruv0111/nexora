generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  EMPLOYER
  ADMIN
}

enum Track {
  QA_SDET
  FULL_STACK
  AI_ENGINEERING
  DATA_ANALYTICS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  REVIEW_REQUIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ApplicationStatus {
  DRAFT
  ASSESSMENT
  WAITLISTED
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  credential    PasswordCredential?
  disabledAt    DateTime?
  forceChange   Boolean             @default(false)
  staffScope    String?
  accountTokens AccountToken[]

  careerProfile      CareerProfile?
  hiringApplications HiringApplication[]
  careerDocuments    CareerDocument[]
  careerResumes      CareerResume[]
  careerConsents     CareerConsent[]
  careerReadiness    CareerReadiness?
  careerMocks        CareerMock[]
  careerRequests     CareerRequest[]
  projectStaff       ProjectStaff[]
  projectTickets     ProjectTicket[]        @relation("TicketAssignee")
  projectEvidence    ContributionEvidence[]
  projectComments    ProjectComment[]
  portfolios         PortfolioEntry[]
  lessonProgress     LessonProgress[]
  attendance         Attendance[]
  notifications      LearningNotification[]
  supportTickets     SupportTicket[]        @relation("TicketOwner")
  assignedTickets    SupportTicket[]        @relation("TicketAssignee")
  supportMessages    SupportMessage[]
  id                 String                 @id @default(cuid())
  name               String?
  email              String?                @unique
  emailVerified      DateTime?
  image              String?
  role               Role                   @default(STUDENT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  mentor             Mentor?
  employer           Employer?
  podMemberships     PodMember[]
  applications       Application[]
  submissions        Submission[]
  assessmentAttempts AssessmentAttempt[]
  applicantProfile   ApplicantProfile?
  auditLogs          AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  description        String             @db.Text
  track              Track
  status             ContentStatus      @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cohorts            Cohort[]
  lessons            Lesson[]
  projects           Project[]
  assessments        Assessment[]
  applications       Application[]
  revisions          CourseRevision[]
  previewVisible     Boolean            @default(false)
  durationWeeks      Int                @default(24)
  deliveryFormat     String             @default("Live mentor-led training")
  audience           String[]           @default([])
  prerequisites      String[]           @default([])
  skills             String[]           @default([])
  technologies       String[]           @default([])
  assessmentRequired Boolean            @default(false)
  contentSource      String?
  contentApprovedAt  DateTime?
  contentVersion     Int                @default(1)
  version            Int                @default(1)
  priceMinor         Int?
  currency           String             @default("INR") @db.Char(3)
  priceVersion       Int                @default(1)
  priceApprovedAt    DateTime?
  termsVersion       String?
  enrollmentTerms    String?            @db.Text
  refundPolicy       String?            @db.Text
  termsApprovedAt    DateTime?
  modules            CurriculumModule[]
  instructors        CourseInstructor[]

  @@index([status, track])
}

model Cohort {
  liveClasses    LiveClass[]
  announcements  Announcement[]
  assessments    Assessment[]
  id             String         @id @default(cuid())
  courseId       String
  name           String
  startsAt       DateTime?
  endsAt         DateTime?
  capacity       Int?
  status         ContentStatus  @default(DRAFT)
  createdAt      DateTime       @default(now())
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  mentors        CohortMentor[]
  pods           AgilePod[]
  assignments    Assignment[]
  admissionsOpen Boolean        @default(false)
  version        Int            @default(1)

  @@unique([courseId, name])
}

model Lesson {
  captionsUrl     String?
  moduleId        String?
  module          CurriculumModule? @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  kind            String            @default("RESOURCE")
  videoUrl        String?
  resourceUrl     String?
  durationSeconds Int               @default(0)
  prerequisiteId  String?
  prerequisite    Lesson?           @relation("LessonPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Restrict)
  dependents      Lesson[]          @relation("LessonPrerequisite")
  version         Int               @default(1)
  updatedAt       DateTime          @default(now()) @updatedAt
  progress        LessonProgress[]
  revisions       LessonRevision[]
  id              String            @id @default(cuid())
  courseId        String
  title           String
  position        Int
  content         String?           @db.Text
  status          ContentStatus     @default(DRAFT)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId, status, position])
}

model Enrollment {
  projectMemberships PodMember[]
  lessonProgress     LessonProgress[]
  id                 String           @id @default(cuid())
  userId             String
  cohortId           String
  status             EnrollmentStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohort             Cohort           @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  payments           Payment[]
  applicationId      String?          @unique
  application        Application?     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reservedUntil      DateTime?
  amountMinor        Int?
  currency           String?          @db.Char(3)
  priceVersion       Int?
  termsVersion       String?
  termsSnapshot      String?          @db.Text
  refundSnapshot     String?          @db.Text
  agreementHash      String?
  agreedAt           DateTime?
  activatedAt        DateTime?
  reviewReason       String?

  @@unique([userId, cohortId])
  @@index([cohortId, status])
}

model Payment {
  id              String         @id @default(cuid())
  enrollmentId    String
  amountMinor     Int
  currency        String         @db.Char(3)
  status          PaymentStatus  @default(PENDING)
  provider        String
  providerRef     String?
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  providerOrderId String?        @unique
  providerReceipt String?        @unique
  orderState      String         @default("NEW")
  verifiedAt      DateTime?
  reconciledAt    DateTime?
  failureCode     String?
  refundedMinor   Int            @default(0)
  events          PaymentEvent[]
  enrollment      Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([enrollmentId, status])
}

model Project {
  productKey     String              @default("training-product")
  technologies   String[]            @default([])
  confidential   Boolean             @default(true)
  engagementType String              @default("SUPERVISED_TRAINING")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  staff          ProjectStaff[]
  pods           AgilePod[]
  repositories   ProjectRepository[]
  id             String              @id @default(cuid())
  courseId       String?
  title          String
  brief          String              @db.Text
  status         ContentStatus       @default(DRAFT)
  course         Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments    Assignment[]

  @@index([courseId])
}

model AgilePod {
  projectId  String?
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  version    Int              @default(1)
  sprints    ProjectSprint[]
  tickets    ProjectTicket[]
  concerns   ProjectConcern[]
  releases   ProjectRelease[]
  id         String           @id @default(cuid())
  cohortId   String?
  name       String
  cohort     Cohort?          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  members    PodMember[]

  @@unique([cohortId, name])
  @@unique([projectId, name])
  @@index([projectId])
}

model PodMember {
  enrollmentId   String?
  enrollment     Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  discipline     Track?
  responsibility String      @default("")
  supervisorId   String?
  leftAt         DateTime?
  version        Int         @default(1)
  podId          String
  userId         String
  joinedAt       DateTime    @default(now())
  pod            AgilePod    @relation(fields: [podId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([podId, userId])
  @@index([userId])
}

model Assignment {
  title         String        @default("Project assignment")
  instructions  String        @default("") @db.Text
  status        ContentStatus @default(DRAFT)
  rubric        Json          @default("[]")
  allowResubmit Boolean       @default(false)
  version       Int           @default(1)
  resourceUrl   String?
  createdAt     DateTime      @default(now())
  id            String        @id @default(cuid())
  cohortId      String
  projectId     String?
  dueAt         DateTime?
  cohort        Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  submissions   Submission[]

  @@unique([cohortId, projectId])
  @@index([cohortId, status, dueAt])
  @@index([projectId])
}

model Submission {
  revisions     SubmissionRevision[]
  body          String               @default("") @db.Text
  state         String               @default("DRAFT")
  version       Int                  @default(1)
  score         Int?
  rubricScores  Json?
  gradedAt      DateTime?
  graderId      String?
  updatedAt     DateTime             @default(now()) @updatedAt
  attachments   LearningFile[]
  id            String               @id @default(cuid())
  assignmentId  String
  userId        String
  repositoryUrl String
  feedback      String?              @db.Text
  submittedAt   DateTime             @default(now())
  assignment    Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, userId])
  @@index([userId])
}

model Assessment {
  cohortId    String?
  cohort      Cohort?             @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  questions   Json                @default("[]")
  passPercent Int                 @default(70)
  maxAttempts Int                 @default(1)
  dueAt       DateTime?
  version     Int                 @default(1)
  id          String              @id @default(cuid())
  courseId    String
  title       String
  maxScore    Int
  status      ContentStatus       @default(DRAFT)
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts    AssessmentAttempt[]

  @@index([courseId])
}

model AssessmentAttempt {
  requestKey     String?    @unique
  answers        Json?
  contentVersion Int        @default(1)
  passed         Boolean?
  id             String     @id @default(cuid())
  assessmentId   String
  userId         String
  score          Int?
  submittedAt    DateTime?
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([assessmentId, userId])
  @@index([userId])
}

model Mentor {
  id        String             @id @default(cuid())
  userId    String             @unique
  bio       String?            @db.Text
  expertise String[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohorts   CohortMentor[]
  courses   CourseInstructor[]
}

model CohortMentor {
  cohortId String
  mentorId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([cohortId, mentorId])
  @@index([mentorId])
}

model Employer {
  verificationStatus String                @default("REGISTERED")
  businessEmail      String                @default("")
  recruiterName      String                @default("")
  industry           String                @default("")
  location           String                @default("")
  requirements       String                @default("") @db.Text
  reviewNote         String                @default("") @db.Text
  reviewedBy         String?
  version            Int                   @default(1)
  registeredAt       DateTime              @default(now())
  consents           CareerConsent[]
  documents          CareerDocument[]
  contracts          RecruitmentContract[]
  id                 String                @id @default(cuid())
  userId             String                @unique
  companyName        String
  website            String?
  verifiedAt         DateTime?
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]
}

model Opportunity {
  skills             String[]            @default([])
  employmentType     String              @default("FULL_TIME")
  location           String              @default("")
  workMode           String              @default("ONSITE")
  eligibility        String              @default("")
  minExperience      Int                 @default(0)
  compensationMin    Int?
  compensationMax    Int?
  currency           String              @default("INR")
  deadline           DateTime?
  moderation         String              @default("PENDING")
  moderationNote     String              @default("")
  moderatedBy        String?
  version            Int                 @default(1)
  duplicateKey       String?             @unique
  hiringApplications HiringApplication[]
  id                 String              @id @default(cuid())
  employerId         String
  title              String
  description        String              @db.Text
  status             ContentStatus       @default(DRAFT)
  createdAt          DateTime            @default(now())
  employer           Employer            @relation(fields: [employerId], references: [id], onDelete: Restrict)
  applications       Application[]

  @@index([employerId, status])
  @@index([status, moderation, deadline])
}

model Application {
  id                    String            @id @default(cuid())
  userId                String
  courseId              String?
  opportunityId         String?
  statement             String?           @db.Text
  status                ApplicationStatus @default(DRAFT)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  course                Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  opportunity           Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  details               Json?
  version               Int               @default(1)
  consentedAt           DateTime?
  consentVersion        String?
  submittedAt           DateTime?
  assessmentStatus      String            @default("PENDING")
  reviewNote            String?           @db.Text
  reviewedAt            DateTime?
  admittedCourseVersion Int?
  enrollment            Enrollment?

  @@unique([userId, courseId])
  @@unique([userId, opportunityId])
  @@index([courseId, status])
  @@index([opportunityId, status])
}

// Anonymous course/career-call inquiries are separate from enrollment applications.
model Inquiry {
  source         String        @default("WEBSITE")
  ownerId        String?
  followUpAt     DateTime?
  suppressed     Boolean       @default(false)
  applicationRef String?
  contacts       LeadContact[]

  triageStatus  String    @default("NEW")
  triagedAt     DateTime?
  id            String    @id @default(cuid())
  name          String
  email         String
  program       String
  intent        String
  message       String?   @db.Text
  consentedAt   DateTime
  noticeVersion String
  submissionKey String    @unique
  fingerprint   String
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([email])
}

model InquiryRateBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model CurriculumModule {
  lessons      Lesson[]
  id           String   @id @default(cuid())
  courseId     String
  startWeek    Int
  title        String
  summary      String   @db.Text
  weeklyTopics String[]
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, startWeek])
}

model CourseInstructor {
  courseId String
  mentorId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Restrict)

  @@id([courseId, mentorId])
  @@index([mentorId])
}

model ApplicantProfile {
  userId    String   @id
  details   Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model PaymentEvent {
  id                String    @id @default(cuid())
  providerEventId   String    @unique
  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  eventType         String
  payloadHash       String
  providerOrderId   String?
  providerPaymentId String?
  state             String    @default("RECEIVED")
  reason            String?
  attempts          Int       @default(0)
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@index([state, receivedAt])
}

model ActionRateBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model CourseRevision {
  id        String   @id @default(cuid())
  courseId  String
  version   Int
  content   Json
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([courseId, version])
}

model LessonProgress {
  id              String     @id @default(cuid())
  enrollmentId    String
  lessonId        String
  userId          String
  positionSeconds Int        @default(0)
  completedAt     DateTime?
  updatedAt       DateTime   @updatedAt
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([userId, updatedAt])
}

model LessonRevision {
  id        String   @id @default(cuid())
  lessonId  String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, version])
}

model LiveClass {
  id           String       @id @default(cuid())
  cohortId     String
  title        String
  description  String       @db.Text
  startsAt     DateTime
  endsAt       DateTime
  meetingUrl   String?
  recordingUrl String?
  status       String       @default("SCHEDULED")
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  cohort       Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  attendance   Attendance[]

  @@index([cohortId, startsAt])
}

model Attendance {
  id         String    @id @default(cuid())
  classId    String
  userId     String
  status     String
  recordedBy String
  updatedAt  DateTime  @updatedAt
  liveClass  LiveClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

model LearningFile {
  id           String     @id @default(cuid())
  submissionId String
  name         String
  mime         String
  size         Int
  sha256       String
  data         Bytes
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Announcement {
  id        String   @id @default(cuid())
  cohortId  String
  title     String
  body      String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, createdAt])
}

model LearningNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SupportTicket {
  requestKey String?          @unique
  id         String           @id @default(cuid())
  userId     String
  assigneeId String?
  subject    String
  category   String
  priority   String
  status     String           @default("OPEN")
  version    Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation("TicketOwner", fields: [userId], references: [id], onDelete: Restrict)
  assignee   User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  messages   SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String
  body      String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model SubmissionRevision {
  id           String     @id @default(cuid())
  submissionId String
  version      Int
  snapshot     Json
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, version])
}

model ProjectStaff {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectSprint {
  id            String          @id @default(cuid())
  podId         String
  name          String
  goal          String          @db.Text
  startsAt      DateTime
  endsAt        DateTime
  status        String          @default("PLANNED")
  retrospective String          @default("") @db.Text
  version       Int             @default(1)
  pod           AgilePod        @relation(fields: [podId], references: [id], onDelete: Restrict)
  tickets       ProjectTicket[]

  @@index([podId, status])
}

model ProjectTicket {
  id               String                 @id @default(cuid())
  podId            String
  sprintId         String?
  assigneeId       String?
  title            String
  requirements     String                 @db.Text
  acceptance       String[]
  definitionOfDone String[]
  priority         String                 @default("MEDIUM")
  kind             String                 @default("STORY")
  status           String                 @default("BACKLOG")
  dueAt            DateTime?
  version          Int                    @default(1)
  codeReviewed     Boolean                @default(false)
  qaAccepted       Boolean                @default(false)
  dodAccepted      Boolean                @default(false)
  securityCleared  Boolean                @default(false)
  issueUrl         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  pod              AgilePod               @relation(fields: [podId], references: [id], onDelete: Restrict)
  sprint           ProjectSprint?         @relation(fields: [sprintId], references: [id], onDelete: Restrict)
  assignee         User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  evidence         ContributionEvidence[]
  comments         ProjectComment[]

  @@index([podId, status, updatedAt])
  @@index([assigneeId])
}

model ContributionEvidence {
  id               String             @id @default(cuid())
  ticketId         String
  userId           String
  kind             String
  summary          String             @db.Text
  url              String?
  status           String             @default("SUBMITTED")
  version          Int                @default(1)
  reviewerId       String?
  feedback         String?            @db.Text
  evaluation       Int?
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  githubVerifiedAt DateTime?
  githubAuthorId   String?
  githubState      String?
  repositoryPublic Boolean            @default(false)
  providerSha      String?
  ticketVersion    Int
  requestKey       String             @unique
  ticket           ProjectTicket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  revisions        EvidenceRevision[]
  files            ProjectFile[]
  portfolios       PortfolioEntry[]

  @@index([userId, status])
  @@index([ticketId, status])
}

model EvidenceRevision {
  id         String               @id @default(cuid())
  evidenceId String
  version    Int
  snapshot   Json
  createdAt  DateTime             @default(now())
  evidence   ContributionEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, version])
}

model ProjectComment {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  body      String        @db.Text
  createdAt DateTime      @default(now())
  ticket    ProjectTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model ProjectFile {
  id         String               @id @default(cuid())
  evidenceId String
  name       String
  mime       String
  size       Int
  sha256     String
  data       Bytes?
  removedAt  DateTime?
  createdAt  DateTime             @default(now())
  evidence   ContributionEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([evidenceId])
}

model PortfolioEntry {
  id          String               @id @default(cuid())
  userId      String
  evidenceId  String
  description String               @db.Text
  challenges  String               @db.Text
  outcome     String               @default("") @db.Text
  status      String               @default("DRAFT")
  feedback    String?
  reviewerId  String?
  approvedAt  DateTime?
  version     Int                  @default(1)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  evidence    ContributionEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([userId, evidenceId])
}

model ProjectConcern {
  id          String    @id @default(cuid())
  podId       String
  kind        String
  description String    @db.Text
  openedBy    String
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  pod         AgilePod  @relation(fields: [podId], references: [id], onDelete: Restrict)

  @@index([podId, resolvedAt])
}

model ProjectRelease {
  id            String   @id @default(cuid())
  podId         String
  title         String
  notes         String   @db.Text
  deploymentUrl String?
  signedBy      String
  status        String   @default("READY")
  createdAt     DateTime @default(now())
  pod           AgilePod @relation(fields: [podId], references: [id], onDelete: Restrict)

  @@index([podId, createdAt])
}

model ProjectRepository {
  id        String  @id @default(cuid())
  projectId String
  fullName  String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
}

model ProjectWebhook {
  processingAt DateTime?
  id           String    @id @default(cuid())
  deliveryId   String    @unique
  payloadHash  String
  event        String
  repository   String?
  state        String    @default("RECEIVED")
  reason       String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
}

model CareerProfile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName     String
  headline        String
  summary         String    @db.Text
  education       String    @db.Text
  background      String    @db.Text
  experienceYears Int       @default(0)
  skills          String[]  @default([])
  preferredRoles  String[]  @default([])
  locations       String[]  @default([])
  workModes       String[]  @default([])
  eligibility     String
  visibility      String    @default("PRIVATE")
  shareContact    Boolean   @default(false)
  seeking         Boolean   @default(false)
  consentVersion  String    @default("career-v1")
  consentedAt     DateTime?
  version         Int       @default(1)
  updatedAt       DateTime  @updatedAt

  @@index([visibility, seeking, updatedAt])
}

model CareerResume {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  version   Int
  content   String?   @db.Text
  createdAt DateTime  @default(now())
  retiredAt DateTime?

  @@unique([userId, version])
}

model CareerConsent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  employerId    String
  employer      Employer  @relation(fields: [employerId], references: [id], onDelete: Restrict)
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  noticeVersion String    @default("career-v1")
  version       Int       @default(1)

  @@unique([userId, employerId])
  @@index([employerId, revokedAt])
}

model HiringApplication {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  status        String            @default("DRAFT")
  statement     String            @db.Text
  version       Int               @default(1)
  createdAt     DateTime          @default(now())
  appliedAt     DateTime?
  updatedAt     DateTime          @updatedAt
  history       HiringHistory[]
  interviews    HiringInterview[]
  outcome       HiringOutcome?

  @@unique([userId, opportunityId])
  @@index([opportunityId, status, updatedAt])
  @@index([userId, updatedAt])
}

model HiringHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actorId       String
  fromStatus    String
  toStatus      String
  note          String            @db.Text
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model HiringInterview {
  id              String            @id @default(cuid())
  applicationId   String
  application     HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  round           String
  startsAt        DateTime
  endsAt          DateTime
  timezone        String            @default("Asia/Kolkata")
  availability    String            @default("") @db.Text
  meetingUrl      String            @default("")
  status          String            @default("REQUESTED")
  feedback        String            @default("") @db.Text
  privateFeedback String            @default("") @db.Text
  version         Int               @default(1)
  createdAt       DateTime          @default(now())

  @@index([applicationId, startsAt])
}

model HiringOutcome {
  applicationId     String            @id
  application       HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  offerReference    String            @default("") @db.Text
  offeredAt         DateTime?
  offerVerifiedAt   DateTime?
  offerVerifierId   String?
  joinedAt          DateTime?
  joiningVerifiedAt DateTime?
  joiningVerifierId String?
  verificationNote  String            @default("") @db.Text
  version           Int               @default(1)

  @@index([offerVerifiedAt])
  @@index([joiningVerifiedAt])
}

model CareerReadiness {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  ready         Boolean  @default(false)
  communication Int      @default(0)
  preparation   Int      @default(0)
  overrideScore Int?
  reason        String   @db.Text
  reviewerId    String
  version       Int      @default(1)
  reviewedAt    DateTime @default(now())
}

model CareerMock {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  mentorId     String
  startsAt     DateTime
  endsAt       DateTime
  availability String   @db.Text
  status       String   @default("REQUESTED")
  feedback     String   @default("") @db.Text
  score        Int?
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([userId, startsAt])
  @@index([mentorId, startsAt])
}

model CareerRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject   String
  message   String   @db.Text
  response  String   @default("") @db.Text
  status    String   @default("OPEN")
  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CareerDocument {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  employerId String?
  employer   Employer? @relation(fields: [employerId], references: [id], onDelete: Restrict)
  name       String
  mime       String
  size       Int
  sha256     String
  bytes      Bytes?
  removedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([employerId])
}

model RecruitmentContract {
  id              String               @id @default(cuid())
  employerId      String
  employer        Employer             @relation(fields: [employerId], references: [id], onDelete: Restrict)
  reference       String
  feeType         String               @default("FIXED")
  feeValue        Int
  currency        String               @default("INR")
  replacementDays Int                  @default(0)
  refundDays      Int                  @default(0)
  status          String               @default("DRAFT")
  version         Int                  @default(1)
  createdAt       DateTime             @default(now())
  invoices        RecruitmentInvoice[]

  @@unique([employerId, reference])
}

model RecruitmentInvoice {
  id          String              @id @default(cuid())
  contractId  String
  contract    RecruitmentContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reference   String              @unique
  amountMinor Int
  currency    String              @default("INR")
  status      String              @default("DRAFT")
  createdAt   DateTime            @default(now())
}

model AccountToken {
  digest    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  expiresAt DateTime

  @@index([userId, purpose])
}

model LeadContact {
  id        String   @id @default(cuid())
  leadId    String
  lead      Inquiry  @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actorId   String
  note      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model RefundRequest {
  id          String   @id @default(cuid())
  paymentId   String
  amountMinor Int
  status      String   @default("REQUESTED")
  reason      String
  actorId     String
  createdAt   DateTime @default(now())

  @@index([paymentId, status])
}

model MentorAvailability {
  mentorId     String   @id
  availability String
  updatedAt    DateTime @updatedAt
}

model PartnerStatus {
  employerId String   @id
  status     String
  reference  String
  updatedAt  DateTime @updatedAt
}

model PasswordCredential {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash   String
}
